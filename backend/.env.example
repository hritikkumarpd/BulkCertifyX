# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=certificates
# used by npm run migrate (direct Postgres connection string)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── Redis (BullMQ) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Razorpay ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Razorpay Plan IDs created in the dashboard (one per tier+cycle)
RAZORPAY_PLAN_STARTER_MONTHLY=plan_xxx
RAZORPAY_PLAN_STARTER_ANNUAL=plan_xxx
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxx
RAZORPAY_PLAN_PRO_ANNUAL=plan_xxx
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=plan_xxx
RAZORPAY_PLAN_ENTERPRISE_ANNUAL=plan_xxx

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="BulkCertifyX <no-reply@bulkcertifyx.com>"

# ── Security ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Observability (optional) ──────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
